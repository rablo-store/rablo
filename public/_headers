/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://api.razorpay.com"), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://www.googletagmanager.com https://checkout.razorpay.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com https://www.google-analytics.com https://region1.google-analytics.com https://*.razorpay.com https://api.instagram.com; frame-src https://*.razorpay.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me https://*.razorpay.com https://*.instagram.com;
  Strict-Transport-Security: max-age=31536000

# Cache-control for static hashed assets (Vite / Astro compiled)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-control for local banner images
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-control for brand vector & image assets
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Cache-control strictly for category static image files (never matching SSR routes)
/categories/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/categories/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Cache-control for static webmanifest & icons
/site.webmanifest
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

# Private, seller, cart, and auth routes: strictly never cache, never index
/account/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/account
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/seller/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/seller
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/cart/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/cart
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/auth/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/auth/callback
  Referrer-Policy: no-referrer

/auth/callback/
  Referrer-Policy: no-referrer
