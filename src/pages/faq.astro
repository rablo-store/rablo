---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FaqSection, FAQ_DATA } from '../components/islands/FaqSection';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_DATA.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Frequently Asked Questions (FAQ) | Rablo"
  description="Everything you need to know about Rablo's direct-to-DM model, zero-commission policy, creator moderation, and UPI payments."
>
  <div class="store-width py-8 sm:py-12 space-y-8">
    <nav class="flex items-center gap-2 text-xs text-[#685950]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9E4A2B] transition-colors">Home</a>
      <span>&gt;</span>
      <span class="text-[#30251F] font-semibold">FAQ</span>
    </nav>

    <FaqSection client:load isDedicatedPage={true} />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

