---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategoriesWithCounts, type CategoryWithCount } from '../lib/products';
import { getCategoryImageUrl } from '../lib/categories';
import {
  ShoppingBag,
  Sparkles,
  Palette,
  Smartphone,
  Gem,
  Shirt,
  Home,
  BookOpen,
  Coffee,
  Heart,
  Tag,
  Scissors,
  ArrowRight,
} from 'lucide-react';

let categories: CategoryWithCount[] = [];
let fetchError: string | null = null;

try {
  categories = await getCategoriesWithCounts();
} catch (err: any) {
  console.error('Failed to load categories:', err);
  fetchError = err?.message || 'Unable to load categories at this time.';
}

function getCategoryIcon(slug: string) {
  const s = slug.toLowerCase();
  if (s.includes('bag')) return ShoppingBag;
  if (s.includes('pottery') || s.includes('ceramic')) return Coffee;
  if (s.includes('jewel') || s.includes('gem')) return Gem;
  if (s.includes('sticker') || s.includes('stationery') || s.includes('book')) return BookOpen;
  if (s.includes('cloth') || s.includes('apparel') || s.includes('wear')) return Shirt;
  if (s.includes('decor') || s.includes('home') || s.includes('living')) return Home;
  if (s.includes('crochet') || s.includes('knit') || s.includes('craft')) return Scissors;
  if (s.includes('phone') || s.includes('mobile') || s.includes('cover') || s.includes('digital') || s.includes('tech')) return Smartphone;
  if (s.includes('art') || s.includes('print')) return Palette;
  if (s.includes('access')) return Sparkles;
  if (s.includes('care') || s.includes('beauty')) return Heart;
  return Tag;
}
---

<BaseLayout
  title="Shop by Category | Rijlo Independent Creators"
  description="Explore handmade creations, crochet, pottery, jewelry, and indie art by craft category on Rijlo."
>
  <div class="store-width py-8 sm:py-12 space-y-8">
    {/* Screen 11: Header */}
    <header class="space-y-2 max-w-xl">
      <h1 class="text-3xl sm:text-4xl font-display font-bold text-[#30251F] tracking-tight">
        Shop by Category
      </h1>
      <p class="text-xs sm:text-sm text-[#685950] leading-relaxed">
        Discover unique pieces crafted with love by verified independent makers and artisans.
      </p>
    </header>

    {fetchError ? (
      <div class="p-8 sm:p-12 text-center bg-[#FAF6F0] rounded-3xl border border-[#30251F]/10 space-y-4 max-w-md mx-auto">
        <div class="w-12 h-12 rounded-full bg-red-100 text-red-700 flex items-center justify-center mx-auto font-bold text-lg">
          !
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-display font-bold text-[#30251F]">Categories Currently Unavailable</h2>
          <p class="text-xs text-[#685950]">{fetchError}</p>
        </div>
        <a
          href="/catalog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0] shadow-sm hover:bg-[#83381E] transition-all"
        >
          <span>Explore All Products</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    ) : categories.length === 0 ? (
      <div class="p-8 sm:p-12 text-center bg-[#FAF6F0] rounded-3xl border border-[#30251F]/10 space-y-4 max-w-md mx-auto">
        <div class="w-12 h-12 rounded-full bg-[#EFE9DF] text-[#9E4A2B] flex items-center justify-center mx-auto">
          <Tag className="w-6 h-6" />
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-display font-bold text-[#30251F]">No Categories Found</h2>
          <p class="text-xs text-[#685950]">Check back soon as new craft categories are constantly approved.</p>
        </div>
        <a
          href="/catalog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0] shadow-sm hover:bg-[#83381E] transition-all"
        >
          <span>Explore Catalog</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {categories.map((cat) => {
          const IconComponent = getCategoryIcon(cat.slug);
          const imageUrl = cat.image_url || getCategoryImageUrl(cat);
          return (
            <a
              href={`/catalog?category=${cat.slug}`}
              class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-2xl sm:rounded-3xl p-3 sm:p-5 flex flex-col items-center text-center justify-between shadow-soft-sm hover:shadow-soft hover:border-[#9E4A2B]/30 hover:-translate-y-1 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9E4A2B]"
            >
              <div class="w-full aspect-square rounded-xl sm:rounded-2xl overflow-hidden bg-[#EFE9DF] mb-3 sm:mb-4 relative shadow-xs group-hover:scale-[1.02] transition-transform duration-300">
                {imageUrl ? (
                  <img
                    src={imageUrl}
                    alt={cat.name}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center p-4 sm:p-6">
                    <div class="w-14 h-14 sm:w-20 sm:h-20 rounded-2xl bg-white/80 shadow-xs flex items-center justify-center text-[#9E4A2B] group-hover:text-[#83381E] group-hover:bg-white transition-colors">
                      <IconComponent className="w-7 h-7 sm:w-10 sm:h-10" />
                    </div>
                  </div>
                )}
              </div>

              <div class="w-full space-y-1">
                <h2 class="font-display font-bold text-sm sm:text-base text-[#30251F] group-hover:text-[#9E4A2B] transition-colors leading-snug line-clamp-1">
                  {cat.name}
                </h2>
                <p class="text-[11px] sm:text-xs text-[#8A7A70]">
                  {cat.product_count !== undefined
                    ? `${cat.product_count} ${cat.product_count === 1 ? 'product' : 'products'}`
                    : 'Browse collection'}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
