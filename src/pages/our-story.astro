---
import BaseLayout from '../layouts/BaseLayout.astro';
import OurStorySection from '../components/OurStorySection.astro';
---

<BaseLayout
  title="Our Story & Philosophy | Rijlo"
  description="Learn about Rijlo's origins, our direct-to-DM decentralized commerce protocol, and our mission to support independent creators across India."
>
  <div class="store-width py-8 sm:py-12 space-y-8">
    <nav class="flex items-center gap-2 text-xs text-[#685950]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9E4A2B] transition-colors">Home</a>
      <span>&gt;</span>
      <span class="text-[#30251F] font-semibold">Our Story</span>
    </nav>

    <OurStorySection isDedicatedPage={true} />
  </div>
</BaseLayout>

