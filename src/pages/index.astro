---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBannerSlider from '../components/islands/HomeBannerSlider';
import HomeTrendingProducts from '../components/islands/HomeTrendingProducts';
import HomeNewArrivals from '../components/islands/HomeNewArrivals';
import HomeTrendingCreators from '../components/islands/HomeTrendingCreators';
import AllProductsSection from '../components/islands/AllProductsSection';
import HomeTrendingCategories from '../components/islands/HomeTrendingCategories';
import { SITE } from '../config/site';
import {
  getTrendingProducts,
  getNewArrivals,
  getAllProductsPage,
  getActiveBanners,
  getTrendingCreators,
  getTrendingCategories,
} from '../lib/home';

// Pre-fetch curated homepage items during SSR for fast First Contentful Paint & zero hydration layout shift
const [
  bannersRes,
  trendingRes,
  newArrivalsRes,
  creatorsRes,
  allProductsRes,
  categoriesRes,
] = await Promise.all([
  getActiveBanners().catch((err) => ({ data: [], error: err instanceof Error ? err.message : 'Banner fetch error' })),
  getTrendingProducts().catch((err) => ({ data: [], error: err instanceof Error ? err.message : 'Trending products fetch error' })),
  getNewArrivals().catch((err) => ({ data: [], error: err instanceof Error ? err.message : 'New arrivals fetch error' })),
  getTrendingCreators().catch((err) => ({ data: [], error: err instanceof Error ? err.message : 'Trending creators fetch error' })),
  getAllProductsPage(0).catch((err) => ({ items: [], data: null, hasMore: false, error: err instanceof Error ? err.message : 'All products fetch error' })),
  getTrendingCategories().catch((err) => ({ data: [], error: err instanceof Error ? err.message : 'Trending categories fetch error' })),
]);

const hasFetchError = Boolean(
  bannersRes.error ||
  trendingRes.error ||
  newArrivalsRes.error ||
  creatorsRes.error ||
  allProductsRes.error ||
  categoriesRes.error
);

const initialBanners = bannersRes.data || [];
const initialTrending = trendingRes.data || [];
const initialNewArrivals = newArrivalsRes.data || [];
const initialCreators = creatorsRes.data || [];
const initialAllProducts = allProductsRes.items || [];
const initialCategories = categoriesRes.data || [];
const firstBanner = initialBanners[0];
const bannerPreloads = firstBanner ? [
  {
    media: '(max-width: 639px)',
    href: firstBanner.mobile_image_url || firstBanner.tablet_image_url || firstBanner.image_url,
  },
  {
    media: '(min-width: 640px) and (max-width: 1023px)',
    href: firstBanner.tablet_image_url || firstBanner.image_url,
  },
  {
    media: '(min-width: 1024px)',
    href: firstBanner.image_url,
  },
].filter((item) => Boolean(item.href)) : undefined;

// Public homepage cache headers on Cloudflare edge (guest requests)
const hasAuthCookie = Astro.request.headers.get('cookie')?.includes('sb-') || false;
if (hasFetchError) {
  Astro.response.headers.set('Cache-Control', 'no-store');
} else if (!hasAuthCookie) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=180, stale-while-revalidate=600');
}
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  preloadImages={bannerPreloads}
>
  <div class="store-width space-y-8 sm:space-y-12 pt-3 sm:pt-5 pb-16">
    {/* 1. Banner Slider (Hero image slider; empty = rendered nothing) */}
    <HomeBannerSlider client:idle initialBanners={initialBanners} />

    {/* 2. Trending Products (D3: max 12, admin-curated, empty = hidden) */}
    <HomeTrendingProducts client:visible initialProducts={initialTrending} />

    {/* 3. New Arrivals (D4: newest 8 approved, empty = hidden) */}
    <HomeNewArrivals client:visible initialProducts={initialNewArrivals} />

    {/* 4. Trending Creators (D5: max 8, admin-curated, empty = hidden) */}
    <HomeTrendingCreators client:visible initialCreators={initialCreators} />

    {/* 5. All Products (D7: 8 per page, infinite scroll up to 48) */}
    <AllProductsSection client:visible initialProducts={initialAllProducts} />

    {/* 6. Trending Categories (D6: max 4, admin-curated, empty = hidden) */}
    <HomeTrendingCategories client:visible initialCategories={initialCategories} />
  </div>
</BaseLayout>
