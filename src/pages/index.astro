---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBannerSlider from '../components/islands/HomeBannerSlider';
import HomeTrendingProducts from '../components/islands/HomeTrendingProducts';
import HomeNewArrivals from '../components/islands/HomeNewArrivals';
import HomeTrendingCreators from '../components/islands/HomeTrendingCreators';
import AllProductsSection from '../components/islands/AllProductsSection';
import HomeTrendingCategories from '../components/islands/HomeTrendingCategories';
import { SITE } from '../config/site';
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
>
  <div class="store-width space-y-8 sm:space-y-12 pt-3 sm:pt-5 pb-16">
    {/* 1. Banner Slider (Hero image slider; empty = rendered nothing) */}
    <HomeBannerSlider client:load />

    {/* 2. 4-Box Value-Props Bar */}
    <section class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4" aria-label="Why shop on Rablo">
      <div class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-2xl p-3 sm:p-4 flex items-center gap-3 shadow-soft-sm hover:border-[#9E4A2B]/30 transition-all">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#9E4A2B]/10 text-[#9E4A2B] flex items-center justify-center flex-shrink-0 text-base sm:text-lg">
          ✦
        </div>
        <div class="min-w-0">
          <p class="font-semibold text-xs sm:text-sm text-[#30251F] truncate">Discover</p>
          <p class="text-[10px] sm:text-xs text-[#685950] truncate">Unique Products</p>
        </div>
      </div>

      <div class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-2xl p-3 sm:p-4 flex items-center gap-3 shadow-soft-sm hover:border-[#9E4A2B]/30 transition-all">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#9E4A2B]/10 text-[#9E4A2B] flex items-center justify-center flex-shrink-0 text-base sm:text-lg">
          📷
        </div>
        <div class="min-w-0">
          <p class="font-semibold text-xs sm:text-sm text-[#30251F] truncate">Connect</p>
          <p class="text-[10px] sm:text-xs text-[#685950] truncate">on Instagram</p>
        </div>
      </div>

      <div class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-2xl p-3 sm:p-4 flex items-center gap-3 shadow-soft-sm hover:border-[#9E4A2B]/30 transition-all">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#9E4A2B]/10 text-[#9E4A2B] flex items-center justify-center flex-shrink-0 text-base sm:text-lg">
          🏷️
        </div>
        <div class="min-w-0">
          <p class="font-semibold text-xs sm:text-sm text-[#30251F] truncate">0% Commission</p>
          <p class="text-[10px] sm:text-xs text-[#685950] truncate">No hidden fees</p>
        </div>
      </div>

      <div class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-2xl p-3 sm:p-4 flex items-center gap-3 shadow-soft-sm hover:border-[#9E4A2B]/30 transition-all">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#9E4A2B]/10 text-[#9E4A2B] flex items-center justify-center flex-shrink-0 text-base sm:text-lg">
          🤍
        </div>
        <div class="min-w-0">
          <p class="font-semibold text-xs sm:text-sm text-[#30251F] truncate">Support</p>
          <p class="text-[10px] sm:text-xs text-[#685950] truncate">Independent Creators</p>
        </div>
      </div>
    </section>

    {/* 3. Trending Products (D3: max 12, admin-curated, empty = hidden) */}
    <HomeTrendingProducts client:visible />

    {/* 4. New Arrivals (D4: newest 8 approved, empty = hidden) */}
    <HomeNewArrivals client:visible />

    {/* 5. Trending Creators (D5: max 8, admin-curated, empty = hidden) */}
    <HomeTrendingCreators client:visible />

    {/* 6. All Products (D7: 8 per page, infinite scroll up to 48) */}
    <AllProductsSection client:visible />

    {/* 7. Trending Categories (D6: max 4, admin-curated, empty = hidden) */}
    <HomeTrendingCategories client:visible />
  </div>
</BaseLayout>
