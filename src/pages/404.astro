---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Rablo"
  description="The requested page could not be found."
  noindex={true}
>
  <div class="rablo-container" style="display:flex;align-items:center;justify-content:center;min-height:60vh;text-align:center;">
    <div style="max-width:500px;padding:3rem 1.5rem;">
      <div style="font-size:4rem;margin-bottom:1rem;">🛍️</div>
      <h1 style="font-size:2rem;font-weight:800;color:var(--color-text);margin-bottom:0.75rem;">
        404 — Page Not Found
      </h1>
      <p style="color:var(--color-text-muted);font-size:0.95rem;margin-bottom:2rem;line-height:1.6;">
        The creator catalog or page you're searching for might have moved, or the link may be outdated.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;">
        <a href="/catalog" class="btn btn-primary" style="padding:0.75rem 1.75rem;">
          Browse Catalog ↗
        </a>
        <a href="/" class="btn btn-outline" style="padding:0.75rem 1.75rem;">
          Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
