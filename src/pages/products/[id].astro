---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailView from '../../components/islands/ProductDetailView';

const { id } = Astro.params;
---

<BaseLayout
  title="Creation Details | rablo"
  description="View artisan details and connect with verified Instagram creators directly on rablo."
>
  <div class="store-width py-12 sm:py-16">
    <ProductDetailView client:load productId={id || ''} />
  </div>
</BaseLayout>
