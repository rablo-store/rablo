---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import type { InitialAuth } from '../lib/server-auth';

const initialAuth = (Astro.locals as { initialAuth?: InitialAuth | null })?.initialAuth ?? null;

const tocItems = [
  { id: 'who-we-are', title: '1. Who we are & contact' },
  { id: 'who-covers', title: '2. Who this policy covers' },
  { id: 'info-we-collect', title: '3. Information we collect' },
  { id: 'how-we-use', title: '4. How & why we use info' },
  { id: 'cookies', title: '5. Cookies & technologies' },
  { id: 'sharing', title: '6. Who we share with' },
  { id: 'international-transfers', title: '7. International transfers' },
  { id: 'data-retention', title: '8. How long we keep data' },
  { id: 'security', title: '9. Security' },
  { id: 'your-rights', title: '10. Your privacy rights' },
  { id: 'deletion', title: '11. Deleting account & data' },
  { id: 'children', title: '12. Children' },
  { id: 'third-party-links', title: '13. Third-party services' },
  { id: 'automated-decisions', title: '14. Automated decisions' },
  { id: 'content-you-publish', title: '15. Content you publish' },
  { id: 'policy-changes', title: '16. Changes to this policy' },
  { id: 'grievance', title: '17. Complaints & Grievance' },
];
---

<BaseLayout
  title="Privacy Policy | Rijlo"
  description="Learn how Rijlo collects, processes, and protects your personal data under global privacy standards, GDPR, CCPA, and India DPDP Act 2023."
  initialAuth={initialAuth}
>
  <div class="store-width py-8 sm:py-12 space-y-8 sm:space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#685950]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9E4A2B] transition-colors">Home</a>
      <span>&gt;</span>
      <span class="text-[#30251F] font-semibold">Privacy Policy</span>
    </nav>

    <!-- Header Banner -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#9E4A2B]/10 text-[#9E4A2B] border border-[#9E4A2B]/20">
        <span>Privacy &amp; Data Protection</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#30251F] tracking-tight">
        Rijlo Privacy Policy
      </h1>
      <p class="text-xs sm:text-sm text-[#685950] font-sans">
        Last updated: <span class="text-[#30251F] font-medium">November 17, 2026</span> &middot; Effective date: <span class="text-[#30251F] font-medium">November 17, 2026</span>
      </p>

      <!-- Policy Switcher Tabs -->
      <div class="pt-2">
        <div class="inline-flex flex-wrap p-1.5 bg-[#FAF6F0] border border-[#30251F]/15 rounded-2xl gap-1">
          <a
            href="/terms"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium text-[#685950] hover:text-[#30251F] hover:bg-white/60 transition-all"
          >
            Terms of Service
          </a>
          <a
            href="/privacy"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-[#9E4A2B] text-white shadow-soft-sm transition-all"
            aria-current="page"
          >
            Privacy Policy
          </a>
          <a
            href="/data-deletion"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium text-[#685950] hover:text-[#30251F] hover:bg-white/60 transition-all"
          >
            Data Deletion
          </a>
        </div>
      </div>
    </header>

    <!-- Mobile Table of Contents Accordion -->
    <details class="lg:hidden bg-white/90 border border-[#30251F]/10 rounded-2xl p-4 shadow-soft-sm group">
      <summary class="flex items-center justify-between font-semibold text-xs sm:text-sm text-[#30251F] cursor-pointer list-none">
        <span class="flex items-center gap-2 text-[#9E4A2B]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
          Table of Contents
        </span>
        <span class="text-[#685950] text-xs">Jump to section &darr;</span>
      </summary>
      <nav class="mt-3 pt-3 border-t border-[#30251F]/10 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-[#685950]">
        {tocItems.map((item) => (
          <a href={`#${item.id}`} class="hover:text-[#9E4A2B] hover:underline transition-colors py-0.5">
            {item.title}
          </a>
        ))}
      </nav>
    </details>

    <!-- Main Content Layout (Sidebar + Document) -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
      <!-- Desktop Sticky Sidebar -->
      <aside class="hidden lg:block lg:w-72 flex-shrink-0">
        <div class="sticky top-24 bg-white/80 backdrop-blur border border-[#30251F]/10 rounded-2xl p-5 shadow-soft-sm space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[#9E4A2B] font-display">
            On this page
          </h2>
          <nav class="space-y-1 text-xs text-[#685950] max-h-[calc(100vh-180px)] overflow-y-auto pr-2">
            {tocItems.map((item) => (
              <a
                href={`#${item.id}`}
                class="block py-1 px-2 rounded-lg hover:bg-[#FAF6F0] hover:text-[#9E4A2B] transition-colors leading-tight"
              >
                {item.title}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Legal Body Card -->
      <article class="flex-1 min-w-0 bg-white border border-[#30251F]/10 rounded-2xl sm:rounded-3xl p-6 sm:p-10 lg:p-12 shadow-soft-sm space-y-10 sm:space-y-12 text-sm sm:text-[15px] leading-relaxed text-[#40342D]">

        <!-- Section 1 -->
        <section id="who-we-are" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">01</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">1. Who we are and how to contact us</h2>
          </div>
          <p>
            Rijlo (&ldquo;Rijlo&rdquo;, &ldquo;we&rdquo;, &ldquo;us&rdquo;) is an online marketplace at <a href="https://rijlo.com" class="text-[#9E4A2B] font-medium hover:underline">https://rijlo.com</a> (the &ldquo;Service&rdquo;) where independent creators and brands showcase products and people discover them and send enquiries. The Service is operated by Ayush Katiyar (operating as Rijlo), of Kalyanpur, Kanpur Nagar, Uttar Pradesh, India.
          </p>
          <div class="bg-[#FAF6F0] p-4 rounded-xl border border-[#30251F]/10 space-y-1.5 text-xs sm:text-sm">
            <p><strong class="text-[#30251F]">Data Protection Status:</strong> For the purposes of data protection law, we are the controller of your personal data (GDPR / UK GDPR), the &ldquo;business&rdquo; (CCPA/CPRA) and the &ldquo;Data Fiduciary&rdquo; (India DPDP Act 2023).</p>
            <p><strong class="text-[#30251F]">Privacy Contact:</strong> <a href="mailto:support@rijlo.com" class="text-[#9E4A2B] hover:underline font-medium">support@rijlo.com</a></p>
            <p><strong class="text-[#30251F]">Grievance Officer (India):</strong> See Section 17.</p>
          </div>
        </section>

        <!-- Section 2 -->
        <section id="who-covers" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">02</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">2. Who this policy covers</h2>
          </div>
          <p>
            This policy applies to everyone who uses Rijlo: visitors, signed-in users who browse or send enquiries, and creators who register a brand or list products. It does not cover websites or services run by others that we link to (see Section 13).
          </p>
        </section>

        <!-- Section 3 -->
        <section id="info-we-collect" class="scroll-mt-24 space-y-6">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">03</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">3. Information we collect</h2>
          </div>

          <div class="space-y-3">
            <h3 class="text-base sm:text-lg font-bold text-[#30251F]">3.1 Information you give us</h3>
            <ul class="space-y-2 list-disc list-inside text-xs sm:text-sm text-[#40342D]">
              <li><strong class="text-[#30251F]">Account data:</strong> Name, email address and profile picture from your Google account when you sign in. We never receive your Google password.</li>
              <li><strong class="text-[#30251F]">Creator and brand data:</strong> Brand name, description, logo, images, category, location (city or country), your Instagram handle, website or social links, and contact details you choose to add.</li>
              <li><strong class="text-[#30251F]">Instagram verification data:</strong> A one-time verification code we generate, the method you pick (bio code or direct message), when you submitted it, the result of our review, and, for the direct message method, your Instagram username and the message you send us.</li>
              <li><strong class="text-[#30251F]">Listing data:</strong> Product names, descriptions, prices, categories and images you upload.</li>
              <li><strong class="text-[#30251F]">Enquiries and messages:</strong> Items in your Lead Cart, messages sent through chat or contact forms, and any contact details you include.</li>
              <li><strong class="text-[#30251F]">Support data:</strong> What you send to <a href="mailto:support@rijlo.com" class="text-[#9E4A2B] hover:underline font-medium">support@rijlo.com</a> and our replies.</li>
            </ul>
          </div>

          <div class="space-y-3">
            <h3 class="text-base sm:text-lg font-bold text-[#30251F]">3.2 Information collected automatically</h3>
            <ul class="space-y-2 list-disc list-inside text-xs sm:text-sm text-[#40342D]">
              <li><strong class="text-[#30251F]">Device and usage data:</strong> IP address, browser and device type, operating system, language, pages viewed, referring page, timestamps, and error and security logs.</li>
              <li><strong class="text-[#30251F]">Session data:</strong> A sign-in token kept in your browser so you stay signed in.</li>
              <li><strong class="text-[#30251F]">Approximate location:</strong> Country or city level, derived from your IP address. We do not collect precise GPS location.</li>
            </ul>
          </div>

          <div class="space-y-3">
            <h3 class="text-base sm:text-lg font-bold text-[#30251F]">3.3 Information from third parties</h3>
            <ul class="space-y-2 list-disc list-inside text-xs sm:text-sm text-[#40342D]">
              <li><strong class="text-[#30251F]">Google:</strong> Name, email, profile picture and a unique account identifier when you use Google sign-in.</li>
              <li><strong class="text-[#30251F]">Instagram / Meta:</strong> We do not pull data from Instagram automatically via their API. We only collect your public Instagram username and read your public bio content for verification purposes, or receive direct messages you manually send us.</li>
            </ul>
            <div class="p-3.5 rounded-xl bg-[#FAF6F0] border-l-4 border-[#9E4A2B] text-xs text-[#685950]">
              <strong class="text-[#30251F]">No sensitive data:</strong> We do not intentionally collect special-category or sensitive data (health, biometric, precise location, government ID, financial account numbers, race, religion, sexual life). Please do not send it in messages or listings. If we learn we have received it, we will delete it.
            </div>
          </div>
        </section>

        <!-- Section 4 -->
        <section id="how-we-use" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">04</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">4. How and why we use your information</h2>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-[#30251F]/20 bg-[#FAF6F0]/60">
                  <th class="py-2.5 px-3 font-semibold text-[#30251F]">Purpose</th>
                  <th class="py-2.5 px-3 font-semibold text-[#30251F]">Data Used</th>
                  <th class="py-2.5 px-3 font-semibold text-[#9E4A2B]">Legal Basis (GDPR / Global)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#30251F]/10 text-[#40342D]">
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Create &amp; secure account, stay signed in</td>
                  <td class="py-2.5 px-3">Account data, session data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Contract</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Show creator brands &amp; products publicly</td>
                  <td class="py-2.5 px-3">Brand, listing data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Contract</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Verify Instagram &amp; review seller applications</td>
                  <td class="py-2.5 px-3">Verification data, brand data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Legitimate interests (fraud prevention)</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Deliver enquiries &amp; messages between users &amp; creators</td>
                  <td class="py-2.5 px-3">Enquiry data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Contract</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Run, maintain &amp; improve the Service, fix bugs</td>
                  <td class="py-2.5 px-3">Usage and device data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Legitimate interests</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Prevent fraud, abuse, spam &amp; security incidents</td>
                  <td class="py-2.5 px-3">Usage, account &amp; verification data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Legitimate interests, legal obligation</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Send service messages (verification, approvals, policies)</td>
                  <td class="py-2.5 px-3">Account data</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Contract, legitimate interests</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3 font-medium text-[#30251F]">Comply with law &amp; respond to lawful requests</td>
                  <td class="py-2.5 px-3">Any data needed</td>
                  <td class="py-2.5 px-3 text-[#9E4A2B] font-medium">Legal obligation</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-xs sm:text-sm text-[#685950] pt-2">
            Under India&apos;s DPDP Act we process your data on the basis of your consent and for the &ldquo;legitimate uses&rdquo; the Act permits, such as providing a service you requested and complying with the law.
          </p>
          <div class="p-3 bg-[#FAF6F0] rounded-xl border border-[#30251F]/10 text-xs font-medium text-[#30251F]">
            &bull; We do not sell your personal data.<br />
            &bull; We do not &ldquo;share&rdquo; it for cross-context behavioural advertising.<br />
            &bull; We do not use it to train third-party AI models.
          </div>
        </section>

        <!-- Section 5 -->
        <section id="cookies" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">05</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">5. Cookies and similar technologies</h2>
          </div>
          <p>
            <strong class="text-[#30251F]">Essential (always on):</strong> Keep you signed in, protect against forgery, remember basic settings. The Service cannot work without them.
          </p>
          <p>
            We do not currently use advertising or non-essential analytics cookies. You can block cookies in your browser, but you may then be unable to sign in or use the Service.
          </p>
        </section>

        <!-- Section 6 -->
        <section id="sharing" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">06</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">6. Who we share your information with</h2>
          </div>
          <ul class="space-y-2 list-disc list-inside text-xs sm:text-sm text-[#40342D]">
            <li><strong class="text-[#30251F]">Service providers:</strong> Supabase (authentication, database, file storage); Cloudflare (hosting, CDN, security, email routing); Google (sign-in). They may use your data only to provide services to us, under written contracts.</li>
            <li><strong class="text-[#30251F]">Meta / Instagram:</strong> When you choose to verify by direct message or connect Instagram. Meta handles your data under its own policy.</li>
            <li><strong class="text-[#30251F]">Creators:</strong> When you send them an enquiry.</li>
            <li><strong class="text-[#30251F]">The public:</strong> For content you choose to publish as a creator (see Section 15).</li>
            <li><strong class="text-[#30251F]">Authorities and advisers:</strong> Where required by law or to protect rights, safety and the integrity of the Service, and to professional advisers under confidentiality.</li>
            <li><strong class="text-[#30251F]">A successor:</strong> If Rijlo is merged, acquired or sold. We will tell you before your data becomes subject to a different policy.</li>
          </ul>
        </section>

        <!-- Section 7 -->
        <section id="international-transfers" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">07</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">7. International transfers</h2>
          </div>
          <p>
            We and our providers may process data in countries other than your own, including India and the United States. Where required, we use lawful transfer mechanisms such as the EU Standard Contractual Clauses, the UK International Data Transfer Addendum, adequacy decisions, or the EU-US / UK-US / Swiss-US Data Privacy Framework certifications of our providers. You can request a copy of the safeguards by contacting us.
          </p>
        </section>

        <!-- Section 8 -->
        <section id="data-retention" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">08</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">8. How long we keep data</h2>
          </div>
          <ul class="space-y-1.5 list-disc list-inside text-xs sm:text-sm text-[#40342D]">
            <li><strong class="text-[#30251F]">Account and profile:</strong> Until you delete your account, then deleted or anonymised within 30 days.</li>
            <li><strong class="text-[#30251F]">Creator brand and product data:</strong> While your store is active, then removed within 30 days of deletion.</li>
            <li><strong class="text-[#30251F]">Instagram verification codes:</strong> Expire after 7 days; the verification outcome is kept while your store is active.</li>
            <li><strong class="text-[#30251F]">Enquiries and messages:</strong> 12 months after the last message unless needed for a dispute.</li>
            <li><strong class="text-[#30251F]">Security and server logs:</strong> Up to 90 days.</li>
            <li><strong class="text-[#30251F]">Records required by law (tax, fraud, legal claims):</strong> For the period the law requires.</li>
            <li><strong class="text-[#30251F]">Backups:</strong> Overwritten within 35 days.</li>
          </ul>
          <p class="text-xs text-[#685950]">
            When the purpose ends we delete or irreversibly anonymise the data.
          </p>
        </section>

        <!-- Section 9 -->
        <section id="security" class="scroll-mt-24 space-y-4">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">09</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">9. Security</h2>
          </div>
          <p>
            We use encryption in transit (HTTPS), access controls, row-level database security, least-privilege admin access, and separation of duties so users cannot change their own verification or approval status. No system is perfectly secure. If a breach is likely to harm you we will notify you and the regulators as the law requires (for example within 72 hours to EU supervisory authorities where applicable).
          </p>
        </section>

        <!-- Section 10 -->
        <section id="your-rights" class="scroll-mt-24 space-y-6">
          <div class="flex items-baseline gap-3 border-b border-[#30251F]/10 pb-2">
            <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[#9E4A2B]/10 text-[#9E4A2B]">10</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#30251F]">10. Your rights</h2>
          </div>
          <p>
            We respond to requests within 30 days (one month under GDPR, 45 days under CCPA, extendable where the law permits). We may need to verify your identity. Contact <a href="mailto:support@rijlo.com" class="text-[#9E4A2B] font-medium hover:underline">support@rijlo.com</a>, or use our deletion page at <a href="/data-deletion" class="text-[#9E4A2B] font-medium hover:underline">https://rijlo.com/data-deletion</a>.
          </p>

          <div class="space-y-3">
            <h3 class="text-base font-bold text-[#30251F]">10.1 Everyone</h3>
            <p class="text-xs sm:text-sm">
              Access, correct, update and delete your personal data; withdraw consent at any time; and ask us questions about how we use your data. Withdrawal does not affect earlier lawful processing.
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="text-base font-bold text-[#30251F]">10.2 European Economic Area, United Kingdom and Switzerland</h3>
            <p class="text-xs sm:text-sm">
              In addition: object to processing based on legitimate interests, restrict processing, data portability, and not be subject to solely automated decisions with significant effects (we do not make any). You may complain to your local supervisory authority, for example the ICO in the UK, or the authority in your EU country of residence.
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="text-base font-bold text-[#30251F]">10.3 California and other US states</h3>
            <p class="text-xs sm:text-sm">
              We do not sell or share personal information, and we do not use or disclose sensitive personal information beyond what is needed to provide the Service. You may request to know, access, correct, delete and port your personal information, and not be discriminated against for exercising these rights. Authorised agents may submit requests with proof of authority. You can appeal a refusal by replying to our decision, and you may contact your state attorney general if you disagree with the result.
            </p>
            <p class="text-xs text-[#685950]">
