---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogGrid from '../components/islands/CatalogGrid';
import { getApprovedProducts, getApprovedCategories } from '../lib/products';

// Pre-fetch catalog data during SSR for instant First Contentful Paint
const [initialProducts, initialCategories] = await Promise.all([
  getApprovedProducts(undefined),
  getApprovedCategories(),
]);

// Public catalog cache headers on Cloudflare edge (guest requests)
const hasAuthCookie = Astro.request.headers.get('cookie')?.includes('sb-') || false;
if (!hasAuthCookie) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=180, stale-while-revalidate=600');
}
---

<BaseLayout
  title="All Products | Rijlo Independent Creators"
  description="Discover unique handmade creations, crafts, fashion, and home decor from verified independent creators."
>
  <div class="store-width py-6 sm:py-10 space-y-6 sm:space-y-8">
    {/* Screen 2: Breadcrumbs & Header */}
    <nav class="flex items-center gap-2 text-xs text-[#685950]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9E4A2B] transition-colors">Home</a>
      <span>&gt;</span>
      <span class="text-[#30251F] font-semibold">Products</span>
    </nav>

    <header class="pb-2">
      <h1 class="text-3xl sm:text-4xl font-display font-bold text-[#30251F] tracking-tight">
        All Products
      </h1>
      <p class="text-xs sm:text-sm text-[#685950] mt-1 max-w-xl">
        Explore hand-curated designs from verified indie creators. Chat directly to customize and order.
      </p>
    </header>

    <CatalogGrid
      client:load
      initialProducts={initialProducts}
      initialCategories={initialCategories}
    />
  </div>
</BaseLayout>
