---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SearchView from '../components/islands/SearchView';

const query = Astro.url.searchParams.get('q') || '';
---

<BaseLayout
  title={query ? `Search Results for "${query}" | Rablo` : 'Search Creations & Creators | Rablo'}
  description="Search handmade items, indie crafts, and verified Instagram creators on Rablo."
  noindex={true}
>
  <div class="store-width py-6 sm:py-10 space-y-6">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-[#685950]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9E4A2B] transition-colors">Home</a>
      <span>&gt;</span>
      <span class="text-[#30251F] font-semibold">Search</span>
    </nav>

    <SearchView client:load initialQuery={query} />
  </div>
</BaseLayout>
