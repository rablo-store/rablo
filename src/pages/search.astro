---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogGrid from '../components/islands/CatalogGrid';

const query = Astro.url.searchParams.get('q') || 'crochet bag';
---

<BaseLayout
  title={`Search Results for "${query}" | Rablo`}
  description={`Discover handmade products and indie creators matching "${query}" on Rablo.`}
>
  <div class="store-width py-6 sm:py-10 space-y-6 sm:space-y-8">
    {/* Screen 10: Search Input Header */}
    <div class="max-w-xl mx-auto space-y-4">
      <form action="/search" method="GET" class="relative">
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search products or creators..."
          class="w-full pl-11 pr-10 py-3.5 bg-[#FAF6F0] border border-[#30251F]/15 rounded-2xl text-xs sm:text-sm text-[#30251F] focus:outline-none focus:ring-2 focus:ring-[#9E4A2B] shadow-xs"
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8A7A70]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        {query && (
          <a
            href="/search"
            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-[#8A7A70] hover:text-[#30251F] p-1"
            title="Clear search"
          >
            ✕
          </a>
        )}
      </form>
    </div>

    {/* Screen 10: Search Summary & Tabs */}
    <div class="space-y-4">
      <div>
        <h1 class="font-display font-bold text-2xl sm:text-3xl text-[#30251F]">
          Search Results for "{query}"
        </h1>
        <p class="text-xs sm:text-sm text-[#685950] mt-1">
          Found matching items and independent makers across Rablo.
        </p>
      </div>

      {/* Screen 10: Tabs (Products | Creators) */}
      <div class="flex items-center gap-3 border-b border-[#30251F]/10 pb-2">
        <button
          type="button"
          id="tab-btn-products"
          class="px-4 py-2 rounded-full text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0] shadow-xs cursor-pointer"
        >
          Products
        </button>
        <button
          type="button"
          id="tab-btn-creators"
          class="px-4 py-2 rounded-full text-xs font-semibold bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors cursor-pointer"
        >
          Creators
        </button>
      </div>
    </div>

    {/* Products Results */}
    <div id="search-products-view">
      <CatalogGrid client:load />
    </div>

    {/* Creators Results (Hidden by default, toggled via tab) */}
    <div id="search-creators-view" class="hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <article class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-3xl p-5 flex flex-col items-center text-center justify-between shadow-soft-sm">
          <div class="w-20 h-20 rounded-full overflow-hidden mb-3 bg-[#EFE9DF]">
            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&auto=format&fit=crop&q=80" alt="Nia Sharma" class="w-full h-full object-cover" />
          </div>
          <h2 class="font-display font-bold text-base text-[#30251F]">Nia Sharma</h2>
          <p class="text-xs font-semibold text-[#9E4A2B] mb-2">@crochetbynia</p>
          <p class="text-[11px] text-[#685950] mb-4">Crochet Accessories &bull; 56 Products</p>
          <a href="/creators/crochetbynia" class="w-full py-2 px-4 rounded-xl text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0]">
            View Profile &rarr;
          </a>
        </article>

        <article class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-3xl p-5 flex flex-col items-center text-center justify-between shadow-soft-sm">
          <div class="w-20 h-20 rounded-full overflow-hidden mb-3 bg-[#EFE9DF]">
            <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=200&auto=format&fit=crop&q=80" alt="Ananya Roy" class="w-full h-full object-cover" />
          </div>
          <h2 class="font-display font-bold text-base text-[#30251F]">Ananya Roy</h2>
          <p class="text-xs font-semibold text-[#9E4A2B] mb-2">@threadtales</p>
          <p class="text-[11px] text-[#685950] mb-4">Floral Embroidery &bull; 32 Products</p>
          <a href="/creators/threadtales" class="w-full py-2 px-4 rounded-xl text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0]">
            View Profile &rarr;
          </a>
        </article>
      </div>
    </div>
  </div>

  <script>
    const prodBtn = document.getElementById('tab-btn-products');
    const creatBtn = document.getElementById('tab-btn-creators');
    const prodView = document.getElementById('search-products-view');
    const creatView = document.getElementById('search-creators-view');

    if (prodBtn && creatBtn && prodView && creatView) {
      prodBtn.addEventListener('click', () => {
        prodBtn.className = 'px-4 py-2 rounded-full text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0] shadow-xs cursor-pointer';
        creatBtn.className = 'px-4 py-2 rounded-full text-xs font-semibold bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors cursor-pointer';
        prodView.classList.remove('hidden');
        creatView.classList.add('hidden');
      });

      creatBtn.addEventListener('click', () => {
        creatBtn.className = 'px-4 py-2 rounded-full text-xs font-semibold bg-[#9E4A2B] text-[#FAF6F0] shadow-xs cursor-pointer';
        prodBtn.className = 'px-4 py-2 rounded-full text-xs font-semibold bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors cursor-pointer';
        creatView.classList.remove('hidden');
        prodView.classList.add('hidden');
      });
    }
  </script>
</BaseLayout>

