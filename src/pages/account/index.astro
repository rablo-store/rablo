---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AccountView } from '../../components/islands/AccountView';
---

<BaseLayout
  title="Customer & Creator Account | Rablo"
  description="Manage your Rablo profile, become a seller, or sign in with Google."
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    <header class="space-y-3 pb-6 border-b border-charcoal-800/10">
      <p class="eyebrow">User &amp; Creator Portal</p>
      <h1 class="text-3xl sm:text-4xl font-display font-medium text-charcoal-900 tracking-tight">
        My Account
      </h1>
      <p class="text-sm text-charcoal-700">
        Sign in via Google to save items to your lead cart, list creations, or access your seller dashboard.
      </p>
    </header>

    <!-- Account View Island -->
    <AccountView client:load />

    <!-- Privacy & Security Guarantee in CUMID format -->
    <div class="p-4 rounded-sm bg-ivory-100 border border-charcoal-800/10 text-xs text-charcoal-700 space-y-1">
      <p class="font-semibold text-charcoal-900">Privacy &amp; Security Guarantee:</p>
      <p>
        Rablo uses Google OAuth and Supabase with strict row-level security. We never collect passwords, credit cards, or banking credentials. All enquiries route safely to Instagram.
      </p>
    </div>
  </div>
</BaseLayout>
