---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import CartView from '../components/islands/CartView';
---

<BaseLayout
  title="Saved Lead Cart | Rablo"
  description="Review your saved Instagram creator leads and initiate direct conversations."
  noindex={true}
>
  <div class="store-width py-12 sm:py-16 space-y-10 max-w-4xl mx-auto">
    <header class="space-y-3 pb-6 border-b border-charcoal-800/10 text-center sm:text-left">
      <p class="eyebrow">Lead Pipeline</p>
      <h1 class="text-3xl sm:text-4xl font-display font-medium text-charcoal-900 tracking-tight">
        Your Saved Creator Leads
      </h1>
      <p class="text-sm text-charcoal-700 max-w-xl leading-relaxed">
        Save products from multiple Instagram sellers, review your choices, and tap to connect directly in Instagram DMs.
      </p>
    </header>

    <CartView client:load />
  </div>
</BaseLayout>
