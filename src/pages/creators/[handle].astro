---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DESIGN_BOARD_DUMMY_PRODUCTS } from '../../lib/products';

const { handle } = Astro.params;

// Lookup creator or fallback to default
const creatorHandle = handle || 'crochetbynia';

const CREATOR_DATA: Record<string, any> = {
  crochetbynia: {
    handle: 'crochetbynia',
    name: 'Nia Sharma',
    brand: 'crochet by Nia',
    category: 'Crochet Accessories • Handmade with Love ♡',
    avatar: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&auto=format&fit=crop&q=80',
    banner: 'https://images.unsplash.com/photo-1590874103328-eac38a683ce7?w=1200&auto=format&fit=crop&q=80',
    productsCount: 56,
    followers: '2.4K',
    reviewsCount: '120+',
    rating: '4.9',
    instagramUrl: 'https://instagram.com/crochetbynia',
  },
  thecandlelab: {
    handle: 'thecandlelab',
    name: 'Aarav Mehta',
    brand: 'The Candle Lab',
    category: 'Scented Candles • Small Studio Batches ♡',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&auto=format&fit=crop&q=80',
    banner: 'https://images.unsplash.com/photo-1603006905003-be475563bc59?w=1200&auto=format&fit=crop&q=80',
    productsCount: 24,
    followers: '4.1K',
    reviewsCount: '95+',
    rating: '4.8',
    instagramUrl: 'https://instagram.com/thecandlelab',
  },
  mudandmuse: {
    handle: 'mudandmuse',
    name: 'Tara Sundaram',
    brand: 'Mud & Muse Pottery',
    category: 'Ceramics & Pottery • Wheel-Thrown Arts ♡',
    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&auto=format&fit=crop&q=80',
    banner: 'https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?w=1200&auto=format&fit=crop&q=80',
    productsCount: 28,
    followers: '6.8K',
    reviewsCount: '180+',
    rating: '5.0',
    instagramUrl: 'https://instagram.com/mudandmuse',
  },
  beadwithlove: {
    handle: 'beadwithlove',
    name: 'Dia Patel',
    brand: 'Bead With Love',
    category: 'Handmade Jewellery • Indie Aesthetic ♡',
    avatar: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=400&auto=format&fit=crop&q=80',
    banner: 'https://images.unsplash.com/photo-1611591475837-128a167098f9?w=1200&auto=format&fit=crop&q=80',
    productsCount: 41,
    followers: '3.2K',
    reviewsCount: '110+',
    rating: '4.9',
    instagramUrl: 'https://instagram.com/beadwithlove',
  },
};

const creator = CREATOR_DATA[creatorHandle.toLowerCase()] || {
  handle: creatorHandle,
  name: 'Verified Creator',
  brand: `@${creatorHandle}`,
  category: 'Handmade & Indie Crafts ♡',
  avatar: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&auto=format&fit=crop&q=80',
  banner: 'https://images.unsplash.com/photo-1590874103328-eac38a683ce7?w=1200&auto=format&fit=crop&q=80',
  productsCount: 32,
  followers: '2.5K',
  reviewsCount: '85+',
  rating: '4.9',
  instagramUrl: `https://instagram.com/${creatorHandle}`,
};

// Filter dummy products for this creator
const creatorProducts = DESIGN_BOARD_DUMMY_PRODUCTS.filter(
  (p) => p.seller_ig_url?.toLowerCase().includes(creator.handle.toLowerCase())
);
const displayProducts = creatorProducts.length > 0 ? creatorProducts : DESIGN_BOARD_DUMMY_PRODUCTS.slice(0, 4);
---

<BaseLayout
  title={`${creator.name} (@${creator.handle}) | Rablo Creator`}
  description={creator.category}
>
  <div class="store-width py-6 sm:py-10 space-y-8">
    {/* Screen 4: Creator Banner & Profile Header */}
    <div class="relative bg-[#FAF6F0] border border-[#30251F]/10 rounded-3xl overflow-hidden shadow-soft">
      {/* Cover Banner */}
      <div class="h-40 sm:h-56 w-full relative overflow-hidden bg-[#EFE9DF]">
        <img
          src={creator.banner}
          alt={creator.name}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
      </div>

      {/* Profile Details Bar */}
      <div class="px-6 sm:px-10 pb-8 pt-0 relative flex flex-col md:flex-row items-center md:items-end justify-between gap-6 -mt-16 sm:-mt-20">
        <div class="flex flex-col sm:flex-row items-center sm:items-end gap-5 text-center sm:text-left">
          {/* Circular Creator Avatar */}
          <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-full overflow-hidden border-4 border-[#FAF6F0] shadow-soft-lg bg-[#EFE9DF] flex-shrink-0 relative">
            <img
              src={creator.avatar}
              alt={creator.name}
              class="w-full h-full object-cover"
            />
          </div>

          <div class="space-y-1">
            <h1 class="font-display font-bold text-2xl sm:text-3xl text-[#30251F]">
              @{creator.handle}
            </h1>
            <p class="text-xs sm:text-sm text-[#685950] font-medium">
              {creator.category}
            </p>

            {/* Stats Row (Screen 4) */}
            <div class="flex items-center justify-center sm:justify-start gap-4 text-xs pt-2">
              <div>
                <span class="font-bold text-[#30251F]">{creator.productsCount}</span>
                <span class="text-[#8A7A70] ml-1">Products</span>
              </div>
              <span class="text-[#30251F]/20">&bull;</span>
              <div>
                <span class="font-bold text-[#30251F]">{creator.followers}</span>
                <span class="text-[#8A7A70] ml-1">Followers</span>
              </div>
              <span class="text-[#30251F]/20">&bull;</span>
              <div>
                <span class="font-bold text-[#30251F]">{creator.rating} ★</span>
                <span class="text-[#8A7A70] ml-1">({creator.reviewsCount})</span>
              </div>
            </div>
          </div>
        </div>

        {/* Action Buttons (Screen 4) */}
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href={creator.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-none px-6 py-3 rounded-full text-xs sm:text-sm font-semibold bg-[#9E4A2B] hover:bg-[#843C22] text-[#FAF6F0] transition-all shadow-sm flex items-center justify-center gap-2"
          >
            <span>Contact on Instagram</span>
            <span aria-hidden="true">&nearr;</span>
          </a>

          <button
            type="button"
            class="px-4 py-3 rounded-full text-xs sm:text-sm font-semibold bg-[#FAF6F0] hover:bg-[#EBE3D7] text-[#30251F] border border-[#30251F]/15 transition-all flex items-center justify-center gap-1.5"
          >
            <span>Save Creator ♡</span>
          </button>
        </div>
      </div>
    </div>

    {/* Tabs (Screen 4: Products, Reviews, About) */}
    <div class="border-b border-[#30251F]/10 flex items-center gap-8 text-sm font-medium">
      <button
        type="button"
        class="pb-3 text-[#9E4A2B] border-b-2 border-[#9E4A2B] font-semibold cursor-pointer"
      >
        Products ({displayProducts.length})
      </button>
      <button
        type="button"
        class="pb-3 text-[#685950] hover:text-[#30251F] cursor-pointer"
      >
        Reviews ({creator.reviewsCount})
      </button>
      <button
        type="button"
        class="pb-3 text-[#685950] hover:text-[#30251F] cursor-pointer"
      >
        About & Policies
      </button>
    </div>

    {/* Products Grid (Screen 4) */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {displayProducts.map((p) => (
        <article class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-2xl p-3 flex flex-col justify-between shadow-soft-sm hover:shadow-soft transition-all group">
          <div class="aspect-square rounded-xl overflow-hidden bg-[#EFE9DF] mb-3 relative">
            <img
              src={p.thumbnail_url || ''}
              alt={p.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform"
            />
            <span class="absolute top-2 right-2 p-1.5 rounded-full bg-[#FAF6F0]/90 text-[#30251F] text-xs shadow-xs">
              ♡
            </span>
          </div>

          <div>
            <h3 class="font-display font-medium text-xs sm:text-sm text-[#30251F] line-clamp-1 mb-1">
              <a href={`/products/${p.id}`} class="hover:text-[#9E4A2B] transition-colors">{p.name}</a>
            </h3>
            <p class="font-bold text-xs sm:text-sm text-[#30251F] mb-3">
              ₹{p.price}
            </p>
          </div>

          <a
            href={`/products/${p.id}`}
            class="w-full py-2 px-3 rounded-xl text-center text-xs font-semibold bg-[#9E4A2B] hover:bg-[#843C22] text-[#FAF6F0] transition-colors"
          >
            View Details
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

