---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DESIGN_BOARD_DUMMY_PRODUCTS } from '../../lib/products';

// Extract unique creators from curated design board & verified list
const CREATORS = [
  {
    handle: 'crochetbynia',
    name: 'Nia Sharma',
    craft: 'Crochet & Handmade',
    avatar: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&auto=format&fit=crop&q=80',
    productsCount: 56,
    followers: '2.4K',
    rating: '4.9',
    tag: 'Trending',
    bio: 'Crochet Accessories • Handmade with Love ♡',
    instagramUrl: 'https://instagram.com/crochetbynia',
  },
  {
    handle: 'thecandlelab',
    name: 'Aarav Mehta',
    craft: 'Scented Candles & Aromas',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&auto=format&fit=crop&q=80',
    productsCount: 24,
    followers: '4.1K',
    rating: '4.8',
    tag: 'Verified',
    bio: '100% Organic Soy Wax Candles poured in small studio batches.',
    instagramUrl: 'https://instagram.com/thecandlelab',
  },
  {
    handle: 'mudandmuse',
    name: 'Tara Sundaram',
    craft: 'Ceramics & Pottery',
    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80',
    productsCount: 28,
    followers: '6.8K',
    rating: '5.0',
    tag: 'Top Rated',
    bio: 'Wheel-thrown stoneware mugs, vases and organic earthenware.',
    instagramUrl: 'https://instagram.com/mudandmuse',
  },
  {
    handle: 'beadwithlove',
    name: 'Dia Patel',
    craft: 'Handmade Jewellery',
    avatar: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=200&auto=format&fit=crop&q=80',
    productsCount: 41,
    followers: '3.2K',
    rating: '4.9',
    tag: 'Trending',
    bio: 'Delicate beaded earrings, freshwater pearl necklaces & indie charms.',
    instagramUrl: 'https://instagram.com/beadwithlove',
  },
  {
    handle: 'casecove',
    name: 'Rohan Sen',
    craft: 'Aesthetic Accessories',
    avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&auto=format&fit=crop&q=80',
    productsCount: 19,
    followers: '1.9K',
    rating: '4.7',
    tag: 'New',
    bio: 'Minimal wave cases and art phone covers for creators.',
    instagramUrl: 'https://instagram.com/casecove',
  },
  {
    handle: 'threadtales',
    name: 'Ananya Roy',
    craft: 'Embroidery & Textile Art',
    avatar: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=200&auto=format&fit=crop&q=80',
    productsCount: 32,
    followers: '5.3K',
    rating: '4.9',
    tag: 'Verified',
    bio: 'Hand-embroidered canvas pouches, floral patches and botanic linens.',
    instagramUrl: 'https://instagram.com/threadtales',
  },
];
---

<BaseLayout
  title="Explore Creators | Rablo Independent Creators"
  description="Meet independent creators, small brands and artisans from across Instagram on Rablo."
>
  <div class="store-width py-8 sm:py-12 space-y-8">
    {/* Screen 5: Creators / Explore Creators Header */}
    <header class="space-y-3 max-w-2xl">
      <h1 class="text-3xl sm:text-4xl font-display font-bold text-[#30251F] tracking-tight">
        Explore Creators
      </h1>
      <p class="text-xs sm:text-sm text-[#685950] leading-relaxed">
        Meet independent creators, small brands and artisans from across Instagram. Connect and order directly.
      </p>
    </header>

    {/* Search & Filter Bar (Screen 5) */}
    <div class="space-y-4">
      <div class="relative max-w-xl">
        <input
          type="text"
          id="creator-search-input"
          placeholder="Search creators (e.g. crochet, art, candles, pottery)..."
          class="w-full pl-10 pr-4 py-3 bg-[#FAF6F0] border border-[#30251F]/15 rounded-2xl text-xs sm:text-sm text-[#30251F] placeholder:text-[#8A7A70] focus:outline-none focus:ring-2 focus:ring-[#9E4A2B] transition-all shadow-xs"
        />
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8A7A70]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      {/* Filter Chips (Screen 5: All Creators, Trending, New, Verified, Top Rated) */}
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        <button
          type="button"
          class="px-4 py-1.5 rounded-full font-medium bg-[#9E4A2B] text-white shadow-xs flex-shrink-0 cursor-pointer"
        >
          All Creators
        </button>
        <button
          type="button"
          class="px-4 py-1.5 rounded-full font-medium bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors flex-shrink-0 cursor-pointer"
        >
          Trending 🔥
        </button>
        <button
          type="button"
          class="px-4 py-1.5 rounded-full font-medium bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors flex-shrink-0 cursor-pointer"
        >
          New ✨
        </button>
        <button
          type="button"
          class="px-4 py-1.5 rounded-full font-medium bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors flex-shrink-0 cursor-pointer"
        >
          Verified ✓
        </button>
        <button
          type="button"
          class="px-4 py-1.5 rounded-full font-medium bg-[#FAF6F0] text-[#30251F] border border-[#30251F]/15 hover:bg-[#EBE3D7] transition-colors flex-shrink-0 cursor-pointer"
        >
          Top Rated ★
        </button>
      </div>
    </div>

    {/* Creator Cards Grid (Screen 5) */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 pt-2">
      {CREATORS.map((c) => (
        <article class="bg-[#FAF6F0] border border-[#30251F]/10 rounded-3xl p-5 flex flex-col items-center text-center justify-between shadow-soft-sm hover:shadow-soft hover:border-[#9E4A2B]/30 transition-all group">
          <div class="w-full flex flex-col items-center">
            {/* Circular Avatar */}
            <div class="relative w-20 h-20 rounded-full overflow-hidden mb-3 border-2 border-[#FAF6F0] shadow-sm bg-[#EFE9DF]">
              <img
                src={c.avatar}
                alt={c.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
              />
              <span class="absolute bottom-0 right-0 w-4 h-4 rounded-full bg-[#637B5B] border-2 border-[#FAF6F0]" title="Active Instagram Maker"></span>
            </div>

            <h2 class="font-display font-bold text-base sm:text-lg text-[#30251F] mb-0.5">
              {c.name}
            </h2>
            <p class="text-xs font-semibold text-[#9E4A2B] mb-2">
              @{c.handle}
            </p>

            <p class="text-[11px] text-[#685950] line-clamp-2 leading-relaxed mb-4 px-2">
              {c.craft} &bull; {c.productsCount} Products
            </p>
          </div>

          <div class="w-full space-y-2 pt-2 border-t border-[#30251F]/10">
            <div class="flex items-center justify-around text-[10px] text-[#8A7A70] py-1">
              <span>{c.followers} Followers</span>
              <span>&bull;</span>
              <span>{c.rating} ★ Rating</span>
            </div>

            <a
              href={`/creators/${c.handle}`}
              class="w-full py-2.5 px-4 rounded-xl text-xs font-semibold bg-[#EFE9DF] hover:bg-[#9E4A2B] text-[#30251F] hover:text-[#FAF6F0] transition-all flex items-center justify-center gap-1.5"
            >
              <span>View Profile</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

