---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandStoreView from '../../components/islands/BrandStoreView';
import { getBrandBySlug, getBrandProducts } from '../../lib/brands';
import type { Product } from '../../lib/products';

const { slug } = Astro.params;
const rawSlug = (slug || '').trim().toLowerCase().replace(/^@/, '');

const brand = rawSlug ? await getBrandBySlug(rawSlug) : null;
const isApproved = brand && brand.approval_status === 'Approved';

let products: Product[] = [];
if (isApproved && brand) {
  products = await getBrandProducts(brand.id);
}

const pageTitle = isApproved && brand
  ? `${brand.name} (@${brand.slug}) — Brand Store | Rablo`
  : 'Creator Not Found | Rablo';

const pageDescription = isApproved && brand
  ? (brand.tagline || brand.bio || `Shop verified handmade creations directly from ${brand.name} on Rablo.`)
  : 'The creator you are looking for is not found on Rablo.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage={isApproved && brand?.logo_url ? brand.logo_url : undefined}
>
  <div class="store-width py-6 sm:py-10">
    {isApproved && brand ? (
      <BrandStoreView client:load brand={brand} products={products} />
    ) : (
      <div class="max-w-md mx-auto text-center py-20 px-6 bg-[#FAF6F0] border border-[#30251F]/10 rounded-3xl space-y-4">
        <div class="w-16 h-16 rounded-full bg-[#EFE9DF] text-[#9E4A2B] mx-auto flex items-center justify-center font-serif text-2xl font-bold">
          ✦
        </div>
        <h1 class="text-2xl font-display font-bold text-[#30251F]">
          Creator Not Found
        </h1>
        <p class="text-xs sm:text-sm text-[#685950] leading-relaxed">
          The creator profile <span class="font-semibold text-[#30251F]">"@{rawSlug}"</span> could not be found or is currently undergoing curation review.
        </p>
        <div class="pt-2">
          <a
            href="/creators"
            class="inline-block px-6 py-3 rounded-full bg-[#9E4A2B] hover:bg-[#843C22] text-[#FAF6F0] text-xs font-semibold shadow-soft-sm transition-all"
          >
            Explore Verified Creators &rarr;
          </a>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

