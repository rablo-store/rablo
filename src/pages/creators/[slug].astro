---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandStoreView from '../../components/islands/BrandStoreView';
import { getBrandBySlug, getBrandByInstagramHandle, getBrandProducts } from '../../lib/brands';
import type { Product } from '../../lib/products';

const { slug } = Astro.params;
const rawSlug = (slug || '').trim().toLowerCase().replace(/^@/, '');

let brand = rawSlug ? await getBrandBySlug(rawSlug) : null;

// If not found by slug, check if this matches an Instagram handle of an approved brand
if (!brand && rawSlug) {
  const brandByHandle = await getBrandByInstagramHandle(rawSlug);
  if (brandByHandle && brandByHandle.approval_status === 'Approved') {
    // 301 permanent redirect to the canonical brand slug
    return Astro.redirect(`/creators/${brandByHandle.slug}`, 301);
  }
}

const isApproved = brand && brand.approval_status === 'Approved';

if (!isApproved || !brand) {
  Astro.response.status = 404;
}

let products: Product[] = [];
let fetchError: string | null = null;
if (isApproved && brand) {
  try {
    products = await getBrandProducts(brand.id);
  } catch (err: any) {
    console.error('Failed to load brand products:', err);
    fetchError = err?.message || 'Unable to load creations for this creator.';
  }
}

const pageTitle = isApproved && brand
  ? `${brand.name} (@${brand.slug}) — Brand Store | Rablo`
  : 'Creator Not Found | Rablo';

const pageDescription = isApproved && brand
  ? (brand.tagline || brand.bio || `Shop verified handmade creations directly from ${brand.name} on Rablo.`)
  : 'The creator you are looking for is not found on Rablo.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage={isApproved && brand?.logo_url ? brand.logo_url : undefined}
>
  <div class="store-width py-6 sm:py-10">
    <BrandStoreView
      client:load
      slug={rawSlug}
      brand={isApproved && brand ? brand : null}
      products={products}
      error={fetchError}
    />
  </div>
</BaseLayout>

