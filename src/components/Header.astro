---
import HeaderNav from './islands/HeaderNav';
import { RABLO_LOGO_HEADER } from '../config/logo';
---

<header class="sticky top-0 z-30 bg-ivory-200 border-b border-charcoal-800/10">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2 sm:gap-4">

      <!-- Brand Logo Lockup -->
      <a
        href="/"
        class="flex-none flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lavender-600 rounded-lg p-1"
        aria-label="Rablo Home"
      >
        <img
          src={RABLO_LOGO_HEADER}
          alt="rablo logo"
          class="w-8 h-8 sm:w-9 sm:h-9 object-contain transition-transform group-hover:scale-105"
          width="36"
          height="36"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
        <span translate="no" class="notranslate font-display text-2xl font-bold tracking-tight text-[#7C0E44] group-hover:text-[#5F0A34] transition-colors lowercase select-none">
          rablo
        </span>
      </a>

      <!-- Header Island: 4 Nav links (Desktop), Search Bar (Responsive), Cart, Auth, & Mobile Menu Bar -->
      <HeaderNav client:load />

    </div>
  </div>
</header>
