---
import CartButton from './islands/CartButton';
import HeaderAuthButton from './islands/HeaderAuthButton';

const navLinks = [
  { label: 'Shop', href: '/#shop', sectionId: 'shop' },
  { label: 'Our Story', href: '/#story', sectionId: 'story' },
  { label: 'FAQ', href: '/#faq', sectionId: 'faq' },
  { label: 'Sell on Rablo', href: '/seller', sectionId: null },
];
---

<header class="sticky top-0 z-30 bg-ivory-200 border-b border-charcoal-800/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2">

      <!-- Brand Logo Lockup -->
      <a
        href="/"
        class="flex-none flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lavender-600 rounded-lg p-1"
        aria-label="Rablo Home"
      >
        <img
          src="/brand/logo-mark.png"
          alt="Rablo Logo"
          class="w-8 h-8 sm:w-9 sm:h-9 object-contain transition-transform group-hover:scale-105"
          width="36"
          height="36"
        />
        <span class="font-display text-2xl font-bold tracking-tight text-[#7C0E44] group-hover:text-[#5F0A34] transition-colors lowercase">
          rablo
        </span>
      </a>

      <!-- Desktop Navigation (md+) with in-page smooth triggering -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-8" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-section-target={link.sectionId}
            class="header-nav-link text-sm font-medium text-charcoal-800 hover:text-lavender-700 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-lavender-600 hover:after:w-full after:transition-all cursor-pointer"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile Quick Nav Pills -->
      <nav
        class="md:hidden flex items-center gap-1.5 overflow-x-auto flex-1 justify-center px-2 py-1 scrollbar-none"
        aria-label="Mobile Navigation"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-section-target={link.sectionId}
            class="header-nav-link flex-none px-3 py-1.5 rounded-full text-xs font-semibold text-charcoal-800 hover:bg-lavender-100 hover:text-lavender-700 active:bg-lavender-200 transition-colors whitespace-nowrap border border-charcoal-800/15"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Header Actions -->
      <div class="flex-none flex items-center space-x-1 sm:space-x-3">
        <!-- Lead Cart Button -->
        <CartButton client:load />

        <!-- User / Admin Profile Button -->
        <HeaderAuthButton client:load />

        <!-- Sell CTA Button -->
        <a
          href="/seller/upload"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-sm text-xs font-medium bg-ivory-200 hover:bg-ivory-300 text-charcoal-800 border border-charcoal-800/20 transition-all"
        >
          <span>+ List Product</span>
        </a>
      </div>

    </div>
  </div>
</header>

<script>
  // Client-side interceptor: In-page navigation without full page reload
  function setupHeaderNav() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.header-nav-link');
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '';

    links.forEach((link) => {
      const sectionId = link.getAttribute('data-section-target');
      if (!sectionId) return; // standard link like /seller

      link.addEventListener('click', (e) => {
        if (isHomePage) {
          const target = document.getElementById(sectionId);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
            window.history.pushState(null, '', `#${sectionId}`);
            window.dispatchEvent(
              new CustomEvent('rablo:section-change', { detail: { sectionId } })
            );
          }
        }
      });
    });
  }

  // Run on initial load and handle Astro page transitions if any
  document.addEventListener('DOMContentLoaded', setupHeaderNav);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupHeaderNav();
  }
</script>
