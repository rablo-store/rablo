---
import HeaderNav from './islands/HeaderNav';
import { RIJLO_LOGO_HEADER } from '../config/logo';
import type { InitialAuth } from '../lib/server-auth';
import { resolveServerAuth } from '../lib/server-auth';

interface Props {
  initialAuth?: InitialAuth | null;
}

const { initialAuth: propsAuth } = Astro.props;

let initialAuth: InitialAuth | null = propsAuth ?? (Astro.locals as any)?.initialAuth ?? null;

// Fallback: If middleware didn't populate initialAuth, resolve directly from request cookies
if (initialAuth === null && Astro.request) {
  try {
    const authRes = await resolveServerAuth(
      Astro.request,
      Astro.cookies
    );
    initialAuth = authRes.initialAuth;
  } catch {}
}
---

<header class="sticky top-0 z-30 bg-[#F5F0E7] border-b border-[#30251F]/10">
  <div class="max-w-[1680px] w-full mx-auto px-3 sm:px-5 lg:px-6 xl:px-8">
    <HeaderNav client:load logoUrl={RIJLO_LOGO_HEADER} initialAuth={initialAuth} />
  </div>
</header>
