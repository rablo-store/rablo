---
import { SITE } from '../config/site';
---

<footer class="bg-charcoal-900 text-ivory-100 border-t border-charcoal-700/40 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 group" aria-label="Rablo Home">
          <img
            src="/brand/logo-mark-light.png"
            alt="Rablo Logo"
            class="w-7 h-7 sm:w-8 sm:h-8 object-contain transition-transform group-hover:scale-105"
            width="32"
            height="32"
          />
          <span class="font-display text-2xl font-bold tracking-tight text-ivory-100 group-hover:text-lavender-300 transition-colors">
            Rablo<span class="text-lavender-300">.</span>
          </span>
        </a>
        <p class="text-xs text-charcoal-300 leading-relaxed">
          {SITE.description}
        </p>
        <p class="text-[11px] text-charcoal-300/80">
          Zero transaction fees. Direct lead routing to verified Instagram creator DMs.
        </p>
      </div>

      <!-- Discover & Sections -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-lavender-300">
          Store & Overview
        </h3>
        <ul class="space-y-2 text-xs text-charcoal-300">
          <li>
            <a href="/#shop" data-footer-section="shop" class="footer-nav-link hover:text-ivory-100 transition-colors">
              Shop Discovery Catalog
            </a>
          </li>
          <li>
            <a href="/#story" data-footer-section="story" class="footer-nav-link hover:text-ivory-100 transition-colors">
              Our Story & Philosophy
            </a>
          </li>
          <li>
            <a href="/#faq" data-footer-section="faq" class="footer-nav-link hover:text-ivory-100 transition-colors">
              Frequently Asked Questions
            </a>
          </li>
        </ul>
      </div>

      <!-- Sellers & Creators -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-lavender-300">
          Instagram Sellers
        </h3>
        <ul class="space-y-2 text-xs text-charcoal-300">
          <li>
            <a href="/seller" class="hover:text-ivory-100 transition-colors">
              Seller Hub & Guidelines
            </a>
          </li>
          <li>
            <a href="/seller/upload" class="hover:text-ivory-100 transition-colors">
              List Your Catalog (+ Add Item)
            </a>
          </li>
          <li>
            <a href="/cart" class="hover:text-ivory-100 transition-colors">
              Saved Lead Cart
            </a>
          </li>
          <li>
            <a href="/account" class="hover:text-ivory-100 transition-colors">
              My Creator Profile
            </a>
          </li>
        </ul>
      </div>

      <!-- Operations & Administration -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-lavender-300">
          Platform & Moderation
        </h3>
        <ul class="space-y-2 text-xs text-charcoal-300">
          <li>
            <a href="/admin" class="hover:text-ivory-100 transition-colors">
              Admin Moderation Portal
            </a>
          </li>
          <li>
            <a href="mailto:sumitkatiyar783@gmail.com" class="hover:text-ivory-100 transition-colors">
              Contact Editorial Desk
            </a>
          </li>
          <li>
            <span class="text-[11px] text-charcoal-300/70 block pt-1">
              Admin: sumitkatiyar783@gmail.com
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Notice & Copyright -->
    <div class="mt-12 pt-8 border-t border-charcoal-700/50 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-charcoal-300">
      <p class="text-center md:text-left">
        &copy; {new Date().getFullYear()} Rablo. Instagram discovery catalog platform. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-[11px] flex-wrap justify-center">
        <span>Direct-to-DM routing</span>
        <span>•</span>
        <span>Zero platform commissions</span>
        <span>•</span>
        <span>100% Creator Profit</span>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupFooterNav() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.footer-nav-link');
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '';

    links.forEach((link) => {
      const sectionId = link.getAttribute('data-footer-section');
      if (!sectionId) return;

      link.addEventListener('click', (e) => {
        if (isHomePage) {
          const target = document.getElementById(sectionId);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
            window.history.pushState(null, '', `#${sectionId}`);
            window.dispatchEvent(
              new CustomEvent('rablo:section-change', { detail: { sectionId } })
            );
          }
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFooterNav);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupFooterNav();
  }
</script>
