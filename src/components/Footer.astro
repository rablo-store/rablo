---
import { SITE } from '../config/site';
import { RIJLO_LOGO_FOOTER } from '../config/logo';
import FooterCreatorsNav from './islands/FooterCreatorsNav';

const currentYear = new Date().getFullYear();

// Check if optional social links exist in SITE config
const socialLinks: Array<{ label: string; href: string }> = [];
if ((SITE as any).instagram) {
  socialLinks.push({ label: 'Instagram', href: (SITE as any).instagram });
}
if ((SITE as any).social?.instagram) {
  socialLinks.push({ label: 'Instagram', href: (SITE as any).social.instagram });
}
---

<footer class="w-full bg-[#30251F] text-[#F5F0E7] mt-auto" role="contentinfo">
  <div class="store-width pt-10 sm:pt-14 lg:pt-16 pb-8 sm:pb-10 pb-[calc(2rem+env(safe-area-inset-bottom,0px))]">
    <!-- 2x2 Grid below 1024px (phones included); 4-col Grid from 1024px up -->
    <div class="footer-grid">
      
      <!-- Block 1: Brand & Mission (Row 1, Col 1 on <1024px; Col 1 5-span on Desktop) -->
      <div class="footer-block-brand min-w-0 space-y-3 sm:space-y-4">
        <a href="/" class="footer-brand-link inline-flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9A37B] rounded-lg" aria-label="Rijlo Home">
          <img
            src={RIJLO_LOGO_FOOTER}
            alt="Rijlo"
            class="footer-brand-logo h-8 sm:h-9 lg:h-10 w-auto object-contain transition-transform group-hover:scale-105 select-none"
            width="262"
            height="80"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-xs sm:text-sm text-[#F5F0E7]/80 leading-relaxed font-sans max-w-sm [overflow-wrap:anywhere]">
          {SITE.description}
        </p>
        <p class="text-xs sm:text-sm text-[#F5F0E7]/80 leading-relaxed font-sans max-w-sm [overflow-wrap:anywhere]">
          Zero platform markups. Direct-to-DM routing to verified independent creators.
        </p>

        {socialLinks.length > 0 && (
          <div class="pt-1 flex items-center gap-3">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-link text-xs sm:text-sm"
                aria-label={`Follow Rijlo on ${s.label}`}
              >
                {s.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Block 2: Discover & Explore (Row 1, Col 2 on <1024px; Col 2 2-span on Desktop) -->
      <div class="footer-block-discover min-w-0 space-y-2.5 sm:space-y-3">
        <h3 class="footer-heading text-[13px] sm:text-sm font-semibold uppercase font-display text-[#D9A37B] leading-snug [overflow-wrap:anywhere]">
          Discover & Explore
        </h3>
        <nav aria-label="Footer: Discover & Explore">
          <ul class="space-y-0.5 sm:space-y-1">
            <li>
              <a href="/catalog" class="footer-link">
                All Products
              </a>
            </li>
            <li>
              <a href="/creators" class="footer-link">
                Explore Creators
              </a>
            </li>
            <li>
              <a href="/categories" class="footer-link">
                Shop by Category
              </a>
            </li>
            <li>
              <a href="/cart" class="footer-link">
                Your Lead Cart
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Block 3: Independent Creators (Row 2, Col 1 on <1024px; Col 3 3-span on Desktop) -->
      <div class="footer-block-creators min-w-0 space-y-2.5 sm:space-y-3">
        <h3 class="footer-heading text-[13px] sm:text-sm font-semibold uppercase font-display text-[#D9A37B] leading-snug [overflow-wrap:anywhere]">
          Independent Creators
        </h3>
        <FooterCreatorsNav client:visible />
      </div>

      <!-- Block 4: Platform & Trust (Row 2, Col 2 on <1024px; Col 4 2-span on Desktop) -->
      <div class="footer-block-platform min-w-0 space-y-2.5 sm:space-y-3">
        <h3 class="footer-heading text-[13px] sm:text-sm font-semibold uppercase font-display text-[#D9A37B] leading-snug [overflow-wrap:anywhere]">
          Platform & Trust
        </h3>
        <nav aria-label="Footer: Platform & Trust">
          <ul class="space-y-0.5 sm:space-y-1">
            <li>
              <a href="/about" class="footer-link">
                About
              </a>
            </li>
            <li>
              <a href="/faq" class="footer-link">
                FAQ
              </a>
            </li>
            <li>
              <a href="/terms" class="footer-link">
                Terms
              </a>
            </li>
            <li>
              <a href="/privacy" class="footer-link">
                Privacy
              </a>
            </li>
            <li>
              <a href="/data-deletion" class="footer-link">
                Data Deletion
              </a>
            </li>
          </ul>
        </nav>
      </div>

    </div>

    <!-- Bottom Notice & Copyright Divider (Full width under grid) -->
    <div class="mt-8 sm:mt-10 lg:mt-12 pt-6 sm:pt-8 border-t border-[#F5F0E7]/15 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs sm:text-sm text-[#F5F0E7]/80 font-sans">
      <p class="text-center sm:text-left text-[#F5F0E7]/80">
        &copy; {currentYear} Rijlo. All rights reserved.
      </p>
      <p class="text-center sm:text-right text-[#F5F0E7]/80">
        0% commission &middot; Direct-to-DM
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 32px;
    align-items: start;
  }
  @media (min-width: 640px) {
    .footer-grid {
      column-gap: 32px;
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 40px;
    }
    .footer-block-brand {
      grid-column: span 5 / span 5;
    }
    .footer-block-discover {
      grid-column: span 2 / span 2;
    }
    .footer-block-creators {
      grid-column: span 3 / span 3;
    }
    .footer-block-platform {
      grid-column: span 2 / span 2;
    }
  }
  @media (max-width: 1023px) {
    .footer-block-brand,
    .footer-block-discover,
    .footer-block-creators,
    .footer-block-platform {
      grid-column: span 1 / span 1;
    }
  }

  .footer-heading {
    letter-spacing: 0.03em;
  }
  @media (min-width: 400px) {
    .footer-heading {
      letter-spacing: 0.08em;
    }
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    min-width: 24px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.4;
    color: rgba(245, 240, 231, 0.8);
    text-decoration: none;
    transition: color 0.15s ease, text-decoration 0.15s ease;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .footer-link:hover {
    color: #D9A37B;
    text-decoration: underline;
  }
  .footer-link:focus,
  .footer-link:focus-visible {
    color: #D9A37B;
    text-decoration: underline;
    outline: 2px solid #D9A37B !important;
    outline-offset: 2px !important;
    box-shadow: 0 0 0 2px #30251F, 0 0 0 4px #D9A37B !important;
  }
  .footer-brand-link {
    min-height: 36px;
    min-width: 24px;
    border-radius: 8px;
    transition: opacity 0.15s ease;
  }
  .footer-brand-link:hover .footer-brand-wordmark {
    color: #D9A37B;
  }
  .footer-brand-link:focus,
  .footer-brand-link:focus-visible {
    outline: 2px solid #D9A37B !important;
    outline-offset: 2px !important;
    box-shadow: 0 0 0 2px #30251F, 0 0 0 4px #D9A37B !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .footer-brand-link,
    .footer-brand-link * {
      transition: none !important;
    }
  }
</style>
