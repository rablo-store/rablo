---
import { SITE } from '../config/site';
---

<footer class="bg-charcoal-900 text-ivory-100 border-t border-charcoal-700/40 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 group" aria-label="Rablo Home">
          <div class="w-8 h-8 rounded-lg bg-[#9E4A2B] text-white flex items-center justify-center font-display font-bold text-lg shadow-xs group-hover:scale-105 transition-transform">
            R
          </div>
          <span class="font-display text-2xl font-bold tracking-tight text-[#FAF6F0] group-hover:text-[#D9A378] transition-colors">
            Rablo
          </span>
        </a>
        <p class="text-xs text-[#B5A9A0] leading-relaxed">
          {SITE.description}
        </p>
        <p class="text-[11px] text-[#8A7A70]">
          Zero platform markups. Direct-to-DM routing to verified independent creators.
        </p>
      </div>

      <!-- Discover & Categories -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-[#D9A378]">
          Discover & Explore
        </h3>
        <ul class="space-y-2 text-xs text-[#B5A9A0]">
          <li>
            <a href="/catalog" class="hover:text-white transition-colors">
              All Products
            </a>
          </li>
          <li>
            <a href="/creators" class="hover:text-white transition-colors">
              Explore Creators
            </a>
          </li>
          <li>
            <a href="/categories" class="hover:text-white transition-colors">
              Shop by Category
            </a>
          </li>
          <li>
            <a href="/cart" class="hover:text-white transition-colors">
              Your Lead Cart
            </a>
          </li>
        </ul>
      </div>

      <!-- Sellers & Creators -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-[#D9A378]">
          Independent Creators
        </h3>
        <ul class="space-y-2 text-xs text-[#B5A9A0]">
          <li>
            <a href="/seller" class="hover:text-white transition-colors">
              Creator Dashboard & Hub
            </a>
          </li>
          <li>
            <a href="/seller/upload" class="hover:text-white transition-colors">
              List Your Creations (+ Add Item)
            </a>
          </li>
          <li>
            <a href="/account" class="hover:text-white transition-colors">
              Creator Profile & Login
            </a>
          </li>
        </ul>
      </div>

      <!-- Operations & Administration -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-[#D9A378]">
          Platform & Trust
        </h3>
        <ul class="space-y-2 text-xs text-[#B5A9A0]">
          <li>
            <a href="/admin" class="hover:text-white transition-colors">
              Admin Moderation Portal
            </a>
          </li>
          <li>
            <a href="/our-story" class="hover:text-white transition-colors">
              Our Story & Philosophy
            </a>
          </li>
          <li>
            <a href="/faq" class="hover:text-white transition-colors">
              Frequently Asked Questions
            </a>
          </li>
          <li>
            <a href="mailto:sumitkatiyar783@gmail.com" class="hover:text-white transition-colors">
              Contact Editorial Desk
            </a>
          </li>
          <li>
            <span class="text-[11px] text-charcoal-300/70 block pt-1">
              Admin: sumitkatiyar783@gmail.com
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Notice & Copyright -->
    <div class="mt-12 pt-8 border-t border-charcoal-700/50 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-charcoal-300">
      <p class="text-center md:text-left">
        &copy; {new Date().getFullYear()} rablo Instagram discovery catalog platform. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-[11px] flex-wrap justify-center">
        <span>Direct-to-DM routing</span>
        <span>•</span>
        <span>Zero platform commissions</span>
        <span>•</span>
        <span>100% Creator Profit</span>
      </div>
    </div>
  </div>
</footer>
