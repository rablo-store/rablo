---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import '../styles/global.css';
import type { InitialAuth } from '../lib/server-auth';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  preloadImage?: string;
  initialAuth?: InitialAuth | null;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  canonicalUrl = new URL(Astro.url.pathname, SITE.canonicalUrl).href,
  noindex = false,
  preloadImage,
  initialAuth,
} = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#252321" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/icon-192.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Preconnect to Font & Storage origins for fast TLS & image handshakes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://ogakjurjotthhcbpqhqf.supabase.co" crossorigin />
    <link rel="dns-prefetch" href="https://ogakjurjotthhcbpqhqf.supabase.co" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}

    <!-- OAuth redirect fail-safe: ensures /auth/callback always executes if redirected to home/other pages -->
    <script is:inline>
      (function() {
        try {
          if (typeof window !== 'undefined') {
            var search = window.location.search || '';
            var hash = window.location.hash || '';
            if ((search.indexOf('code=') !== -1 || hash.indexOf('access_token=') !== -1) &&
                window.location.pathname !== '/auth/callback') {
              window.location.replace('/auth/callback' + search + hash);
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-ivory-200 text-espresso-800 antialiased selection:bg-clay/30 selection:text-espresso-900 flex flex-col min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:p-4">Skip to main content</a>
    <Header initialAuth={initialAuth} />
    
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Instagram Post-Auth Confirmation Toast (Requirement 4: User-gesture triggered window.open) -->
    <script is:inline>
      (function() {
        try {
          if (typeof window === 'undefined') return;

          var urlParams = new URLSearchParams(window.location.search);
          var launchIg = urlParams.get('launch_ig') || urlParams.get('rablo_ig');
          var creatorParam = urlParams.get('creator') || urlParams.get('creator_name');

          if (!launchIg) {
            try {
              launchIg = sessionStorage.getItem('rablo:ig_confirm_url') || localStorage.getItem('rablo:ig_confirm_url');
              if (!creatorParam) {
                creatorParam = sessionStorage.getItem('rablo:ig_confirm_creator') || localStorage.getItem('rablo:ig_confirm_creator');
              }
            } catch (e) {}
          }

          if (launchIg && launchIg !== 'null' && launchIg !== 'undefined' && launchIg.trim()) {
            // Clean storage so confirmation only appears once
            try {
              sessionStorage.removeItem('rablo:ig_confirm_url');
              sessionStorage.removeItem('rablo:ig_confirm_creator');
              localStorage.removeItem('rablo:ig_confirm_url');
              localStorage.removeItem('rablo:ig_confirm_creator');
              localStorage.removeItem('rablo:launch_ig');
              sessionStorage.removeItem('rablo:launch_ig');
              document.cookie = 'rablo_launch_ig=; path=/; max-age=0; SameSite=Lax';
            } catch (e) {}

            // Clean query params from URL without reloading
            if (urlParams.has('launch_ig') || urlParams.has('rablo_ig') || urlParams.has('auth_success') || urlParams.has('creator') || urlParams.has('creator_name')) {
              urlParams.delete('launch_ig');
              urlParams.delete('rablo_ig');
              urlParams.delete('auth_success');
              urlParams.delete('creator');
              urlParams.delete('creator_name');
              var cleanSearch = urlParams.toString();
              var newUrl = window.location.pathname + (cleanSearch ? '?' + cleanSearch : '') + window.location.hash;
              window.history.replaceState({}, document.title, newUrl);
            }

            // Validate and sanitize target inquiry / Instagram URL using allowed hosts
            var ALLOWED_HOSTS = ['instagram.com', 'www.instagram.com', 'ig.me', 'wa.me', 'api.whatsapp.com', 't.me', 'm.me'];
            function sanitizeUrl(str) {
              if (!str || str.length > 500) return null;
              try {
                var p = new URL(str);
                if (p.protocol !== 'https:') return null;
                if (p.username || p.password) return null;
                if (p.port && p.port !== '443') return null;
                var host = p.hostname.toLowerCase();
                var ok = ALLOWED_HOSTS.some(function(h) { return host === h || host.endsWith('.' + h); });
                return ok ? p.toString() : null;
              } catch (e) {
                return null;
              }
            }

            var raw = launchIg.trim();
            var safeTargetUrl = sanitizeUrl(raw);
            if (!safeTargetUrl) return;

            var buttonLabel = 'Chat on Instagram ↗';
            var platformHint = 'Instagram';
            var detectedHandle = '';

            try {
              var pHost = new URL(safeTargetUrl).hostname.toLowerCase();
              if (pHost === 'wa.me' || pHost === 'api.whatsapp.com') {
                buttonLabel = 'Chat on WhatsApp ↗';
                platformHint = 'WhatsApp';
              } else if (pHost === 'instagram.com' || pHost === 'www.instagram.com' || pHost === 'ig.me') {
                buttonLabel = 'Chat on Instagram ↗';
                platformHint = 'Instagram';
                var hMatch = safeTargetUrl.match(/(?:https?:\/\/)?(?:www\.)?instagram\.com\/([^/?#]+)/i);
                if (hMatch && hMatch[1] && !['p', 'reel', 'reels', 'stories', 'explore', 'direct', 'accounts'].includes(hMatch[1].toLowerCase())) {
                  detectedHandle = hMatch[1].replace(/^@/, '');
                }
              } else {
                buttonLabel = 'Open Direct Chat ↗';
                platformHint = 'direct chat';
              }
            } catch (e) {}

            var creatorDisplay = creatorParam && creatorParam.trim() ? creatorParam.trim() : (detectedHandle ? '@' + detectedHandle : 'Creator');

            // Render confirmation banner (Must open in a new tab upon genuine user click)
            var existingCard = document.getElementById('rablo-ig-launcher-banner');
            if (existingCard) existingCard.remove();

            var card = document.createElement('div');
            card.id = 'rablo-ig-launcher-banner';
            card.setAttribute('role', 'status');
            card.setAttribute('aria-live', 'polite');
            card.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:999999;background:#30251F;color:#FAF6F0;border:1px solid rgba(184,117,85,0.4);box-shadow:0 12px 36px rgba(48,37,31,0.3);border-radius:16px;padding:16px 20px;max-width:400px;width:calc(100vw - 32px);display:flex;flex-direction:column;gap:12px;font-family:system-ui,-apple-system,sans-serif;animation:rabloFadeIn 0.3s ease-out;';

            var styleEl = document.createElement('style');
            styleEl.textContent = '@keyframes rabloFadeIn{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}';
            document.head.appendChild(styleEl);

            card.innerHTML = [
              '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">',
                '<div style="display:flex;align-items:center;gap:10px;">',
                  '<div style="width:28px;height:28px;border-radius:50%;background:#9E4A2B;color:#FAF6F0;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:bold;flex-shrink:0;">✓</div>',
                  '<div>',
                    '<div style="font-weight:600;font-size:13px;color:#ffffff;line-height:1.4;">Signed in. Continue to chat with <span style="color:#D9A37B;font-weight:700;">' + creatorDisplay + '</span></div>',
                    '<div style="font-size:11px;color:#B5A9A0;margin-top:2px;">Your session is active. Tap below to open ' + platformHint + '.</div>',
                  '</div>',
                '</div>',
                '<button type="button" id="rablo-ig-banner-close" style="background:transparent;border:0;color:#B5A9A0;font-size:18px;cursor:pointer;padding:0 4px;line-height:1;" aria-label="Close confirmation">&times;</button>',
              '</div>',
              '<div style="display:flex;gap:8px;align-items:center;">',
                '<a href="' + safeTargetUrl + '" target="_blank" rel="noopener noreferrer" id="rablo-ig-launch-btn" style="flex:1;text-align:center;background:#9E4A2B;color:#FAF6F0;font-size:12px;font-weight:600;padding:10px 16px;border-radius:9999px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:6px;transition:background 0.2s;cursor:pointer;">' + buttonLabel + '</a>',
              '</div>'
            ].join('');

            document.body.appendChild(card);

            function dismissBanner() {
              if (card && card.parentNode) {
                card.style.opacity = '0';
                card.style.transform = 'translateY(12px)';
                card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                setTimeout(function() { card.remove(); }, 250);
              }
            }

            var closeBtn = document.getElementById('rablo-ig-banner-close');
            if (closeBtn) {
              closeBtn.addEventListener('click', dismissBanner);
            }

            var launchBtn = document.getElementById('rablo-ig-launch-btn');
            if (launchBtn) {
              launchBtn.addEventListener('click', function() {
                // Auto-dismiss smoothly after user initiates the click
                setTimeout(dismissBanner, 600);
              });
            }
          }
        } catch (err) {
          console.warn('Rablo: IG launcher error', err);
        }
      })();
    </script>
  </body>
</html>
